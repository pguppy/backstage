{
  "name": "@internal/plugin-{{PLUGIN_ID}}-backend",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "backstage": {
    "role": "backend-plugin"
  },
  "pluginId": "{{PLUGIN_ID}}",
  "pluginPackages": [
    "{{PLUGIN_ID}}",
    "{{PLUGIN_ID}}-backend",
    "{{PLUGIN_ID}}-common",
    "{{PLUGIN_ID}}-node",
    "{{PLUGIN_ID}}-react"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/index.ts",
    "./package.json": "./package.json"
